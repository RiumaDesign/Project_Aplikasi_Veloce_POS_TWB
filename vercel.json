{
  "version": 2,
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "api.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/sw.js",
      "dest": "/sw.js"
    },
    {
      "src": "/api.php(.*)",
      "dest": "/api.php$1"
    },
    {
      "src": "/dashboard.php(.*)",
      "dest": "/dashboard.php$1"
    },
    {
      "src": "/login.php(.*)",
      "dest": "/login.php$1"
    },
    {
      "src": "/logout.php(.*)",
      "dest": "/logout.php$1"
    },
    {
      "src": "/export.php(.*)",
      "dest": "/export.php$1"
    },
    {
      "src": "/index.php(.*)",
      "dest": "/index.php$1"
    },
    {
      "src": "/",
      "dest": "/index.php"
    }
  ]
}
